rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /complaints/{complaintId} {
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.category in ['Hostel', 'Mess', 'Wi-Fi', 'Classroom', 'Transport', 'Other']
        && request.resource.data.priority in ['Low', 'Medium', 'High']
        && request.resource.data.keys().hasAll([
          'studentId', 'title', 'description', 'category', 'location',
          'priority', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentId', 'title', 'description', 'category', 'location',
          'priority', 'status', 'createdAt', 'imageUrl'
        ]);
      allow update: if isAdmin()
        && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isAdmin();
    }
  }
}
